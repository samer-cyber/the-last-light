  m_EditorClassIdentifier: Assembly-CSharp::Game.Landmark
  id: MESSAGE
  title: the writing on the wall
  about: Mara Okonjo's last words, scratched into the station's inner north wall
    in her hand, too small to read from the door. She came here for the heart in
    year 98 and never came home
  top: {fileID: 0}
  known: 1
