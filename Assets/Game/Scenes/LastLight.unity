  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Game.Landmark
  id: NEST
  title: Spark's nest
  about: 'your nest by the door: an alcove with the things you kept: Ima''s rubber
    duck, a chipped teacup, a music box that plays four notes, Dr. Hale''s glasses,
    and below them the shells of the other six caretakers. On the wall, your tally
    of days in chalk: 77,112. days. still here.'
  top: {fileID: 0}
  known: 1
