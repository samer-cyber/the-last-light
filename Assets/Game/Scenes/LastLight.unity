  m_EditorClassIdentifier: Assembly-CSharp::Game.Landmark
  id: IMA_DRAWING
  title: Ima's drawing
  about: 'a crayon drawing taped to pod 11''s glass, at a child''s height: you and
    Ima holding hands under a smiling sun; she wrote SPARK + IMA and KEEP THE LITES
    ON!! The night before she went to sleep'
  top: {fileID: 0}
