  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Game.Landmark
  id: YOUR_POD
  title: your pod
  about: 'pod 40, the pod the survivor woke in, the last on the east side. It cracked
    in the cold, so you woke them by protocol 5. Its label is frosted over: only
    the number 40 and the letters R. ARCH can be read; the rest is under the frost'
  top: {fileID: 0}
  known: 1
