  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Game.Landmark
  id: VAULT_DOOR
  title: the vault door
  about: 'the steel blast door out of the vault, from inside. Two hundred years of
    ice hold it in its frame: you have tried for years and you are too small to shift
    it. Heat would melt the ice (a fire beside it, a torch held to it) and a hard
    blow would break it'
  top: {fileID: 0}
  known: 1
