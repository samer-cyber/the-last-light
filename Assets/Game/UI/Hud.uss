/* Over the world: black to open, hints at the bottom, white for the flash, words on the white. */

.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud__black,
.hud__white {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud__black {
    background-color: rgb(0, 0, 0);
    opacity: 1;
}

.hud__white {
    background-color: rgb(255, 255, 255);
    opacity: 0;
}

.hud__hint,
.hud__subtitle {
    position: absolute;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    opacity: 0;
    transition-property: opacity;
}

.hud__hint {
    bottom: 84px;
    transition-duration: 1.1s;
}

.hud__hint--shown {
    opacity: 1;
}

.hud__words {
    margin-right: 34px;
    font-size: 25px;
    letter-spacing: 2px;
    color: rgba(222, 228, 255, 0.88);
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.9);
    -unity-text-align: middle-left;
}

.hud__words--last {
    margin-right: 0;
}

.hud__key {
    margin-right: 12px;
    padding: 4px 12px 4px 12px;
    border-width: 1px;
    border-radius: 6px;
    border-color: rgba(214, 220, 255, 0.5);
    background-color: rgba(10, 10, 24, 0.35);
    font-size: 19px;
    letter-spacing: 2px;
    color: rgba(232, 236, 255, 0.92);
    -unity-text-align: middle-center;
}

.hud__title {
    position: absolute;
    left: 0;
    right: 0;
    top: 46%;
    font-size: 34px;
    letter-spacing: 12px;
    color: rgb(28, 28, 36);
    -unity-text-align: middle-center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 2s;
}

.hud__title--shown {
    opacity: 1;
}

.hud__subtitle {
    bottom: 72px;
    transition-duration: 2s;
}

.hud__subtitle--shown {
    opacity: 1;
}

.hud__subtitle .hud__words {
    color: rgba(60, 60, 72, 0.8);
}

.hud__subtitle .hud__key {
    border-color: rgba(60, 60, 72, 0.4);
    color: rgba(60, 60, 72, 0.9);
}

/* Speaking to the entity: a light, the voice's level and a word, above the hints. */

.hud__listen {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 150px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.hud__listen--shown {
    opacity: 1;
}

.hud__listen-dot {
    width: 14px;
    height: 14px;
    margin-right: 16px;
    border-radius: 7px;
    background-color: rgb(255, 118, 104);
}

.hud__listen-bar {
    width: 220px;
    height: 4px;
    border-radius: 2px;
    background-color: rgba(220, 228, 255, 0.2);
}

.hud__listen-level {
    width: 0%;
    height: 4px;
    border-radius: 2px;
    background-color: rgba(232, 238, 255, 0.92);
}

.hud__listen-words {
    margin-left: 16px;
    font-size: 21px;
    letter-spacing: 2px;
    color: rgba(222, 228, 255, 0.85);
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.9);
}

/* The player's own words, as heard; and short lines in the middle of the view. */

.hud__said,
.hud__note {
    position: absolute;
    left: 12%;
    right: 12%;
    white-space: normal;
    -unity-text-align: middle-center;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.9);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.6s;
}

.hud__said {
    bottom: 196px;
    font-size: 30px;
    color: rgba(242, 244, 255, 0.95);
}

.hud__note {
    top: 30%;
    font-size: 28px;
    letter-spacing: 6px;
    color: rgba(236, 238, 255, 0.9);
}

.hud__said--shown,
.hud__note--shown {
    opacity: 1;
}

/* The frozen world: a dot in the middle of the view, the name of what it rests on, and what the mind holds. */

.hud__aim {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    margin-top: -5px;
    flex-direction: column;
    align-items: center;
}

.hud__aim-dot {
    width: 5px;
    height: 5px;
    border-radius: 3px;
    background-color: rgba(235, 228, 214, 0.45);
}

.hud__aim-dot--on {
    background-color: rgba(255, 236, 205, 0.95);
}

.hud__aim-words {
    margin-top: 14px;
    font-size: 19px;
    letter-spacing: 3px;
    color: rgba(240, 232, 218, 0.85);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.95);
    -unity-text-align: middle-center;
}

.hud__aim-action {
    margin-top: 4px;
    font-size: 16px;
    letter-spacing: 2px;
    color: rgba(255, 214, 160, 0.9);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.95);
    -unity-text-align: middle-center;
}

.hud__carry {
    position: absolute;
    left: 48px;
    bottom: 40px;
    font-size: 18px;
    letter-spacing: 3px;
    color: rgba(225, 218, 205, 0.7);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.95);
}
