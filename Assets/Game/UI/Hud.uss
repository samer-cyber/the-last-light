/* Over the world: black to open, hints at the bottom, white for the flash, words on the white. */

.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud__black,
.hud__white {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud__black {
    background-color: rgb(0, 0, 0);
    opacity: 1;
}

.hud__white {
    background-color: rgb(255, 255, 255);
    opacity: 0;
}

.hud__hint,
.hud__subtitle {
    position: absolute;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    opacity: 0;
    transition-property: opacity;
}

.hud__hint {
    bottom: 84px;
    transition-duration: 1.1s;
}

.hud__hint--shown {
    opacity: 1;
}

.hud__words {
    margin-right: 34px;
    font-size: 25px;
    letter-spacing: 2px;
    color: rgba(222, 228, 255, 0.88);
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.9);
    -unity-text-align: middle-left;
}

.hud__words--last {
    margin-right: 0;
}

.hud__key {
    margin-right: 12px;
    padding: 4px 12px 4px 12px;
    border-width: 1px;
    border-radius: 6px;
    border-color: rgba(214, 220, 255, 0.5);
    background-color: rgba(10, 10, 24, 0.35);
    font-size: 19px;
    letter-spacing: 2px;
    color: rgba(232, 236, 255, 0.92);
    -unity-text-align: middle-center;
}

.hud__title {
    position: absolute;
    left: 0;
    right: 0;
    top: 46%;
    font-size: 34px;
    letter-spacing: 12px;
    color: rgb(28, 28, 36);
    -unity-text-align: middle-center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 2s;
}

.hud__title--shown {
    opacity: 1;
}

.hud__subtitle {
    bottom: 72px;
    transition-duration: 2s;
}

.hud__subtitle--shown {
    opacity: 1;
}

.hud__subtitle .hud__words {
    color: rgba(60, 60, 72, 0.8);
}

.hud__subtitle .hud__key {
    border-color: rgba(60, 60, 72, 0.4);
    color: rgba(60, 60, 72, 0.9);
}

/* Speaking to the entity: a light, the voice's level and a word, above the hints. */

.hud__listen {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 150px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.hud__listen--shown {
    opacity: 1;
}

.hud__listen-dot {
    width: 14px;
    height: 14px;
    margin-right: 16px;
    border-radius: 7px;
    background-color: rgb(255, 118, 104);
}

.hud__listen-bar {
    width: 220px;
    height: 4px;
    border-radius: 2px;
    background-color: rgba(220, 228, 255, 0.2);
}

.hud__listen-level {
    width: 0%;
    height: 4px;
    border-radius: 2px;
    background-color: rgba(232, 238, 255, 0.92);
}

.hud__listen-words {
    margin-left: 16px;
    font-size: 21px;
    letter-spacing: 2px;
    color: rgba(222, 228, 255, 0.85);
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.9);
}

/* The player's own words, as heard; and short lines in the middle of the view. */

.hud__said,
.hud__note {
    position: absolute;
    left: 12%;
    right: 12%;
    white-space: normal;
    -unity-text-align: middle-center;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.9);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.6s;
}

.hud__said {
    bottom: 196px;
    font-size: 30px;
    color: rgba(242, 244, 255, 0.95);
}

.hud__note {
    top: 30%;
    font-size: 28px;
    letter-spacing: 6px;
    color: rgba(236, 238, 255, 0.9);
}

.hud__said--shown,
.hud__note--shown {
    opacity: 1;
}

/* The frozen world: a dot in the middle of the view, the name of what it rests on, and what the mind holds. */

.hud__aim {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    margin-top: -5px;
    flex-direction: column;
    align-items: center;
}

.hud__aim-dot {
    width: 5px;
    height: 5px;
    border-radius: 3px;
    background-color: rgba(235, 228, 214, 0.45);
}

.hud__aim-dot--on {
    background-color: rgba(255, 236, 205, 0.95);
}

.hud__aim-words {
    margin-top: 14px;
    font-size: 19px;
    letter-spacing: 3px;
    color: rgba(240, 232, 218, 0.85);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.95);
    -unity-text-align: middle-center;
}

.hud__aim-action {
    margin-top: 4px;
    font-size: 16px;
    letter-spacing: 2px;
    color: rgba(255, 214, 160, 0.9);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.95);
    -unity-text-align: middle-center;
}

.hud__carry {
    position: absolute;
    left: 48px;
    bottom: 40px;
    font-size: 18px;
    letter-spacing: 3px;
    color: rgba(225, 218, 205, 0.7);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.95);
}


/* The drone's words under the view, its name small before them. */

.hud__voice {
    position: absolute;
    left: 14%;
    right: 14%;
    bottom: 128px;
    flex-direction: column;
    align-items: center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.5s;
}

.hud__voice--shown {
    opacity: 1;
}

.hud__voice-name {
    font-size: 15px;
    letter-spacing: 6px;
    color: rgba(255, 186, 120, 0.9);
    margin-bottom: 6px;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.9);
}

.hud__voice-words {
    font-size: 30px;
    color: rgba(250, 244, 236, 0.97);
    white-space: normal;
    -unity-text-align: upper-center;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.95);
}

/* What the drone's eye saw, framed in the corner. */

.hud__photo {
    position: absolute;
    right: 36px;
    top: 34px;
    width: 480px;
    padding: 8px 8px 10px 8px;
    background-color: rgba(10, 10, 14, 0.6);
    border-width: 1px;
    border-color: rgba(255, 196, 140, 0.55);
    border-radius: 4px;
    opacity: 0;
    translate: 24px 0;
    transition-property: opacity, translate;
    transition-duration: 0.6s, 0.6s;
}

.hud__photo--flash {
    opacity: 1;
    translate: 0 0;
    background-color: rgba(255, 255, 255, 0.95);
    transition-duration: 0.05s, 0.05s;
}

.hud__photo--shown {
    opacity: 1;
    translate: 0 0;
}

.hud__photo-image {
    width: 464px;
    height: 261px;
    -unity-background-scale-mode: scale-and-crop;
}

.hud__photo-caption {
    margin-top: 6px;
    font-size: 14px;
    letter-spacing: 3px;
    color: rgba(255, 196, 140, 0.9);
}

/* The goal and the step now, small in the top left. */

.hud__goal {
    position: absolute;
    left: 40px;
    top: 34px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 1.5s;
}

.hud__goal--shown {
    opacity: 1;
}

.hud__goal-title {
    font-size: 14px;
    letter-spacing: 5px;
    color: rgba(255, 196, 140, 0.85);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.9);
}

.hud__goal-step {
    margin-top: 4px;
    font-size: 21px;
    color: rgba(236, 238, 250, 0.92);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.9);
}

/* White words on the black before the world fades in. */

.hud__card {
    position: absolute;
    left: 10%;
    right: 10%;
    top: 40%;
    font-size: 26px;
    letter-spacing: 9px;
    color: rgba(236, 232, 226, 0.92);
    white-space: normal;
    -unity-text-align: middle-center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 1.2s;
}

.hud__card--shown {
    opacity: 1;
}

/* Spark's hologram of the past, over the whole view, with scan lines. */

.hud__hologram {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
    -unity-background-image-tint-color: rgb(225, 245, 255);
    opacity: 0;
}

.hud__scanlines {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-repeat: repeat repeat;
    background-size: 4px 4px;
    opacity: 0;
}

/* What was earned, high in the middle. */

.hud__honour {
    position: absolute;
    left: 0;
    right: 0;
    top: 110px;
    align-items: center;
    opacity: 0;
    translate: 0 -12px;
    transition-property: opacity, translate;
    transition-duration: 0.8s, 0.8s;
}

.hud__honour--shown {
    opacity: 1;
    translate: 0 0;
}

.hud__honour-title {
    font-size: 30px;
    letter-spacing: 10px;
    color: rgb(255, 205, 140);
    text-shadow: 0 0 18px rgba(255, 150, 60, 0.8);
    padding: 10px 26px 4px 26px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgba(255, 196, 140, 0.55);
}

.hud__honour-line {
    margin-top: 8px;
    font-size: 18px;
    letter-spacing: 2px;
    color: rgba(250, 244, 236, 0.92);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.9);
}

/* Spark's trust, under the goal. */

.hud__trust {
    position: absolute;
    left: 40px;
    top: 102px;
    flex-direction: row;
    align-items: center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 1.2s;
}

.hud__trust--shown {
    opacity: 1;
}

.hud__trust-pips {
    flex-direction: row;
}

.hud__trust-pip {
    width: 14px;
    height: 6px;
    margin-right: 4px;
    border-width: 1px;
    border-color: rgba(255, 196, 140, 0.6);
    background-color: rgba(0, 0, 0, 0.25);
}

.hud__trust-pip--on {
    background-color: rgb(255, 186, 110);
}

.hud__trust-words {
    margin-left: 10px;
    font-size: 13px;
    letter-spacing: 3px;
    color: rgba(255, 220, 180, 0.85);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.9);
}

/* How warm the survivor is: a thin bar low in the middle, only when not full. */

.hud__warmth {
    position: absolute;
    left: 38%;
    bottom: 64px;
    height: 5px;
    width: 24%;
    background-color: rgb(255, 170, 90);
    border-radius: 2px;
    transition-property: opacity, background-color;
    transition-duration: 0.4s, 0.4s;
}

.hud__warmth--low {
    background-color: rgb(140, 200, 255);
}

/* Spark's log, on the right, [L] to open. */

.hud__log {
    position: absolute;
    right: 36px;
    top: 300px;
    width: 440px;
    padding: 14px 18px 16px 18px;
    background-color: rgba(8, 9, 12, 0.82);
    border-left-width: 2px;
    border-color: rgba(255, 186, 110, 0.7);
    opacity: 0;
    translate: 20px 0;
    transition-property: opacity, translate;
    transition-duration: 0.35s, 0.35s;
}

.hud__log--shown {
    opacity: 1;
    translate: 0 0;
}

.hud__log-head {
    font-size: 13px;
    letter-spacing: 6px;
    color: rgb(255, 186, 110);
    margin-bottom: 10px;
}

.hud__log-row {
    margin-bottom: 10px;
}

.hud__log-when {
    font-size: 11px;
    letter-spacing: 3px;
    color: rgba(255, 196, 140, 0.7);
}

.hud__log-entry {
    font-size: 16px;
    color: rgba(245, 240, 232, 0.95);
    white-space: normal;
}

/* The eye's picture: a viewfinder. */

.hud__photo-corner {
    position: absolute;
    width: 18px;
    height: 18px;
    border-color: rgba(255, 255, 255, 0.85);
}

.hud__photo-corner--tl { left: 8px; top: 8px; border-left-width: 2px; border-top-width: 2px; }
.hud__photo-corner--tr { right: 8px; top: 8px; border-right-width: 2px; border-top-width: 2px; }
.hud__photo-corner--bl { left: 8px; bottom: 8px; border-left-width: 2px; border-bottom-width: 2px; }
.hud__photo-corner--br { right: 8px; bottom: 8px; border-right-width: 2px; border-bottom-width: 2px; }

.hud__photo-rec {
    position: absolute;
    right: 14px;
    top: 14px;
    width: 9px;
    height: 9px;
    border-radius: 5px;
    background-color: rgb(255, 60, 50);
}

/* Hit: the edges flash red. */

.hud__hurt {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-width: 90px;
    border-color: rgba(255, 40, 25, 0.45);
    background-color: rgba(255, 40, 25, 0.08);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.35s;
}

/* Frost on the pod's glass, over the whole view. */

.hud__frost {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

/* Spark's protocols: top left, under its trust. The ones it broke are struck through and lit. */

.hud__protocols {
    position: absolute;
    left: 40px;
    top: 132px;
    padding: 10px 16px 10px 14px;
    background-color: rgba(8, 9, 12, 0.62);
    border-left-width: 2px;
    border-color: rgba(160, 200, 255, 0.55);
    opacity: 0;
    translate: -14px 0;
    transition-property: opacity, translate;
    transition-duration: 0.6s, 0.6s;
}

.hud__protocols--shown {
    opacity: 1;
    translate: 0 0;
}

.hud__protocols-head {
    font-size: 14px;
    letter-spacing: 5px;
    color: rgba(180, 210, 255, 0.85);
    margin-bottom: 6px;
}

.hud__protocol {
    font-size: 18px;
    letter-spacing: 1px;
    color: rgba(232, 238, 248, 0.88);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.9);
    margin-bottom: 3px;
}

.hud__protocol--broken {
    color: rgb(255, 186, 110);
    text-shadow: 0 0 10px rgba(255, 140, 50, 0.65);
}


/* A memory's words over the pale wash: dark ink on a soft light band. */

.hud__voice--memory {
    background-color: rgba(236, 242, 250, 0.55);
    padding: 10px 26px 14px 26px;
    border-radius: 6px;
}

.hud__voice--memory .hud__voice-name {
    color: rgba(40, 58, 92, 0.95);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

.hud__voice--memory .hud__voice-words {
    color: rgba(20, 30, 52, 0.98);
    text-shadow: 0 0 10px rgba(255, 255, 255, 0.9);
}

/* A page looked at closely: dark over the view, the page in its own shape, its title above, how to put it down below. */
.hud__inspect {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(4, 6, 9, 0.88);
    align-items: center;
    justify-content: center;
    display: none;
}
.hud__inspect--shown {
    display: flex;
}
.hud__inspect-title {
    color: rgb(255, 186, 112);
    font-size: 18px;
    letter-spacing: 4px;
    margin-bottom: 18px;
    -unity-font-style: bold;
}
.hud__inspect-page {
    -unity-background-scale-mode: scale-to-fit;
}
.hud__inspect-hint {
    color: rgba(238, 234, 226, 0.8);
    font-size: 16px;
    margin-top: 20px;
    letter-spacing: 1px;
}
