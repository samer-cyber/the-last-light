/* Over the world: black to open, hints at the bottom, white for the flash, words on the white. */

.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud__black,
.hud__white {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud__black {
    background-color: rgb(0, 0, 0);
    opacity: 1;
}

.hud__white {
    background-color: rgb(255, 255, 255);
    opacity: 0;
}

.hud__hint,
.hud__subtitle {
    position: absolute;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    opacity: 0;
    transition-property: opacity;
}

.hud__hint {
    bottom: 84px;
    transition-duration: 1.1s;
}

.hud__hint--shown {
    opacity: 1;
}

.hud__words {
    margin-right: 34px;
    font-size: 25px;
    letter-spacing: 2px;
    color: rgba(222, 228, 255, 0.88);
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.9);
    -unity-text-align: middle-left;
}

.hud__words--last {
    margin-right: 0;
}

.hud__key {
    margin-right: 12px;
    padding: 4px 12px 4px 12px;
    border-width: 1px;
    border-radius: 6px;
    border-color: rgba(214, 220, 255, 0.5);
    background-color: rgba(10, 10, 24, 0.35);
    font-size: 19px;
    letter-spacing: 2px;
    color: rgba(232, 236, 255, 0.92);
    -unity-text-align: middle-center;
}

.hud__title {
    position: absolute;
    left: 0;
    right: 0;
    top: 46%;
    font-size: 34px;
    letter-spacing: 12px;
    color: rgb(28, 28, 36);
    -unity-text-align: middle-center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 2s;
}

.hud__title--shown {
    opacity: 1;
}

.hud__subtitle {
    bottom: 72px;
    transition-duration: 2s;
}

.hud__subtitle--shown {
    opacity: 1;
}

.hud__subtitle .hud__words {
    color: rgba(60, 60, 72, 0.8);
}

.hud__subtitle .hud__key {
    border-color: rgba(60, 60, 72, 0.4);
    color: rgba(60, 60, 72, 0.9);
}
